# ==========================================
# SNS 자동 업로드 매크로 설정 (.env)
# ==========================================

# 1. Instagram / Threads (Meta)
INSTAGRAM_USERNAME=your_insta_username
INSTAGRAM_PASSWORD=your_insta_password
# Meta Graph API 사용 시 (선택사항)
META_ACCESS_TOKEN=your_meta_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_id
FACEBOOK_PAGE_ID=your_facebook_page_id
THREADS_USER_ID=your_threads_user_id

# 2. X (Twitter)
TWITTER_USERNAME=your_x_username
TWITTER_PASSWORD=your_x_password
# X API 사용 시 (선택사항)
TWITTER_API_KEY=your_api_key
TWITTER_API_SECRET=your_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret

# 3. Facebook
FACEBOOK_EMAIL=your_facebook_email
FACEBOOK_PASSWORD=your_facebook_password

# 4. TikTok
TIKTOK_USERNAME=your_tiktok_username
TIKTOK_PASSWORD=your_tiktok_password
# TikTok Open API 사용 시 (선택사항)
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# 5. YouTube
# YouTube Data API v3 사용 시 client_secrets.json 파일을 macro 폴더에 배치하세요.
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# 6. Naver Clip (브라우저에서 첫 실행 시 로그인)
# 영상 주제에 맞는 '1차>2차' 카테고리로 바꿔 주세요.
# 2차 카테고리가 없는 경우에는 1차 이름만 입력해요.
NAVER_CLIP_CATEGORY=테크>IT, 컴퓨터
